# Used by `go run ./cmd/sis` / `make run` on the host (Compose publishes Postgres on 5443).
# Inside Docker Compose the service overrides it to point at db:5432.
SIS_DB_URL=postgresql://sis:change-me@localhost:5443/sis?sslmode=disable
SIS_DB=sis
SIS_DB_USERNAME=sis
SIS_DB_PASSWORD=change-me
SIS_DB_MAX_CONNS=64
SIS_DB_TIMEOUT=2s
SIS_ADDR=:8080
SIS_CC=380
SIS_NDCS=67
SIS_NDC_CAPACITY=10000000
SIS_MSISDN_LENGTH=12
SIS_GENERATE=false
TZ=Europe/Prague
